         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Assessing the mineralogy of the watershed and fan deposits of the Jezero crater paleolake system, Mars</rdf:li>
            </rdf:Alt>
         </dc:title>
